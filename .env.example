DATABASE_URL=postgresql://yugabyte@127.0.0.1:5433/mmo_auth?sslmode=disable
LISTEN_ADDRESS=127.0.0.1:8080
PUBLIC_ORIGIN=http://127.0.0.1:8080/
SHUTDOWN_GRACE_SECONDS=20
RUST_LOG=info
DATABASE_MAX_CONNECTIONS=10
DATABASE_ACQUIRE_TIMEOUT_SECONDS=5
MAINTENANCE_INTERVAL_SECONDS=3600

STEAM_LOGIN_TTL_SECONDS=300
STEAM_VERIFY_TIMEOUT_SECONDS=5
EXCHANGE_TTL_SECONDS=60

ACCESS_TOKEN_PRIVATE_KEY_PATH=/home/YOUR_USER/.config/mmo-auth/access-token.pem
ACCESS_TOKEN_KEY_ID=auth-local-1
ACCESS_TOKEN_ISSUER=http://127.0.0.1:8080/
ACCESS_TOKEN_AUDIENCE=mmo
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=2592000

# OpenID browser login continues to work when disabled
STEAMWORKS_ENABLED=false
# When enabled, all three of the following are REQUIRED. Keep publisher key server-side.
# STEAMWORKS_APP_ID=123456
# STEAMWORKS_PUBLISHER_KEY=YOUR_SERVER_ONLY_PUBLISHER_WEB_API_KEY
# STEAMWORKS_TICKET_IDENTITY=mmo-auth
